# PostgreSQL connection string (from Neon)
DATABASE_URL="postgresql://user:password@host:5432/job_tracker?schema=public"

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-this-with-a-long-random-string"

# Base URL of your app, used by Better Auth for callbacks/cookies
BETTER_AUTH_URL="http://localhost:3000"